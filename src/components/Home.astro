---
import Layout from '../layouts/Layout.astro';
import Brand from './Brand.astro';
import ProjectCard from './ProjectCard.astro';
import Icon from './Icon.astro';
import { content, organization, projects, type Language } from '../data/site';
interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const t = content[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const otherLanguage = lang === 'zh' ? 'en' : 'zh';
const home = lang === 'zh' ? `${base}/` : `${base}/en/`;
const languageUrl = lang === 'zh' ? `${base}/en/` : `${base}/`;
---

<Layout lang={lang}>
  <header class="site-header" id="top">
    <div class="container header-inner">
      <a class="brand-link" href={home} aria-label="Rambow Cloud">
        <Brand />
      </a>
      <nav
        class="desktop-nav"
        aria-label={lang === 'zh' ? '主导航' : 'Main navigation'}
      >
        <a href="#projects">{t.nav[0]}</a>
        <a href="#focus">{t.nav[1]}</a>
        <a href="#about">{t.nav[2]}</a>
        <a href="https://blog.rambow.cloud/">{t.blog}</a>
      </nav>
      <div class="header-actions">
        <a
          class="language-link"
          href={languageUrl}
          lang={otherLanguage === 'zh' ? 'zh-CN' : 'en'}
          aria-label={t.languageLabel}
        >
          {t.language}
        </a>
        <a class="github-nav" href={organization}>
          <Icon name="github" />
          <span>{t.github}</span>
          <Icon name="external" size={16} />
        </a>
      </div>
    </div>
    <nav
      class="mobile-nav container"
      aria-label={lang === 'zh' ? '栏目导航' : 'Section navigation'}
    >
      <a href="#projects">{t.nav[0]}</a>
      <a href="#focus">{t.nav[1]}</a>
      <a href="#about">{t.nav[2]}</a>
      <a href="https://blog.rambow.cloud/">{t.blog}</a>
    </nav>
  </header>

  <main id="main">
    <section class="launch-section" aria-labelledby="hero-title">
      <div class="space-scene" aria-hidden="true">
        <div class="nebula"></div>
        <div class="stars"></div>
        <div class="planet">
          <div class="planet-ring"></div>
        </div>
        <div class="orbital-ring"></div>
        <div class="space-grid"></div>
      </div>
      <div class="container launch-content">
        <div class="hero-copy">
          <p class="eyebrow">
            <span class="status-dot"></span>RAMBOW CLOUD / OPEN SOURCE
          </p>
          <h1 id="hero-title">
            {t.headline[0]} <span>{t.headline[1]}</span>
          </h1>
          <p class="hero-description">{t.intro}</p>
        </div>
        <section
          class="projects-section"
          id="projects"
          aria-labelledby="projects-title"
        >
          <div class="section-heading">
            <h2 id="projects-title">{t.projectsTitle}</h2>
            <a class="text-link" href={`${organization}?tab=repositories`}>
              {t.allProjects}
              <Icon name="external" size={16} />
            </a>
          </div>
          <div class="project-grid">
            {projects.map((project, index) => (
              <ProjectCard project={project} index={index} lang={lang} />
            ))}
          </div>
        </section>
        <div class="launch-footnote">
          <span>
            <span class="status-dot"></span>
            {t.heroBottom}
          </span>
          <a class="text-link" href="#focus">
            {t.nav[1]}
            <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>
    </section>

    <div class="technology-strip">
      <div class="container technology-inner">
        <span>CLOUD NATIVE, IN PRACTICE</span>
        <div>
          <span>Go</span>
          <span>AWS Lambda</span>
          <span>OpenTelemetry</span>
          <span>Alibaba Cloud</span>
          <span>draw.io</span>
        </div>
      </div>
    </div>
    <section class="focus-section" id="focus" aria-labelledby="focus-title">
      <div class="container section-space">
        <div class="focus-heading">
          <div>
            <p class="eyebrow section-label">{t.focusLabel}</p>
            <h2 id="focus-title">{t.focusTitle}</h2>
          </div>
          <p>{t.focusIntro}</p>
        </div>
        <div class="focus-grid">
          {t.focus.map((item, index) => (
            <article class="focus-item">
              <div class="focus-item-top">
                <Icon name={item.icon} size={32} />
                <span>0{index + 1}</span>
              </div>
              <h3>{item.title}</h3>
              <h4>{item.subtitle}</h4>
              <p>{item.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section
      class="about-section container section-space"
      id="about"
      aria-labelledby="about-title"
    >
      <div>
        <p class="eyebrow section-label">{t.aboutLabel}</p>
        <h2 id="about-title">
          {t.aboutTitle[0]}
          <br />
          <span>{t.aboutTitle[1]}</span>
        </h2>
        <div class="about-signature">
          <Brand compact />
          <span>rambow cloud / open source</span>
        </div>
      </div>
      <div class="about-copy">
        <p>{t.aboutText}</p>
        <p>{t.aboutMore}</p>
        <ul class="principles">
          {t.principles.map((principle) => (
            <li>
              <span>↗</span>
              {principle}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="join-section container" aria-labelledby="join-title">
      <div class="join-panel">
        <div>
          <p class="eyebrow">{t.joinLabel}</p>
          <h2 id="join-title">{t.joinTitle}</h2>
          <p>{t.joinText}</p>
          <a class="button button-dark" href={organization}>
            {t.joinButton}
            <Icon name="external" />
          </a>
        </div>
        <div class="join-symbol" aria-hidden="true">
          ↗
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer container">
    <div class="footer-main">
      <div>
        <a class="brand-link" href={home} aria-label="Rambow Cloud">
          <Brand />
        </a>
        <p>{t.footer}</p>
      </div>
      <div class="footer-links">
        <a href={organization}>
          GitHub
          <Icon name="external" size={16} />
        </a>
        <a
          href={languageUrl}
          lang={otherLanguage === 'zh' ? 'zh-CN' : 'en'}
          aria-label={t.languageLabel}
        >
          {t.language}
        </a>
        <a href="#top">{t.backTop} ↑</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} Rambow Cloud</span>
      <span>{t.independent}</span>
      <span class="footer-built">
        BUILT IN THE OPEN<span class="status-dot"></span>
      </span>
    </div>
  </footer>
</Layout>
