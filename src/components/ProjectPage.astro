---
import Layout from '../layouts/Layout.astro';
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import {
  content,
  organization,
  projects,
  type Language,
  type Project,
} from '../data/site';

interface Props {
  lang: Language;
  project: Project;
}
const { lang, project } = Astro.props;
const t = content[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = lang === 'zh' ? `${base}/` : `${base}/en/`;
const otherLanguage = lang === 'zh' ? 'en' : 'zh';
const languageUrl = `${base}/${otherLanguage}/projects/${project.name}/`;
const repository = `${organization}/${project.name}`;
---

<Layout lang={lang} project={project}>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand-link" href={home} aria-label="Rambow Cloud">
        <Brand />
      </a>
      <div class="header-actions">
        <a
          class="language-link"
          href={languageUrl}
          lang={otherLanguage === 'zh' ? 'zh-CN' : 'en'}
          aria-label={t.languageLabel}
        >
          {t.language}
        </a>
        <a class="github-nav" href={repository}>
          <Icon name="github" />
          <span>GitHub</span>
        </a>
      </div>
    </div>
  </header>

  <main id="main" class="project-detail container">
    <nav
      class="project-breadcrumb"
      aria-label={lang === 'zh' ? '面包屑导航' : 'Breadcrumb'}
    >
      <a href={home}>{t.home}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{project.displayName}</span>
    </nav>
    <article>
      <header class="project-detail-header">
        <p class="eyebrow section-label">{project.category}</p>
        <h1>{project.displayName}</h1>
        <p class="project-detail-intro">{project.description[lang]}</p>
        <div class="tags">
          {project.tags.map((tag) => (
            <span>{tag}</span>
          ))}
        </div>
        <p class="project-detail-note">{project.note[lang]}</p>
      </header>
      <section class="project-detail-section" aria-labelledby="features-title">
        <h2 id="features-title">{t.projectFeatures}</h2>
        <div class="project-feature-grid">
          {project.details[lang].map((detail) => (
            <div class="project-feature">
              <h3>{detail.title}</h3>
              <p>{detail.text}</p>
            </div>
          ))}
        </div>
      </section>
      <section class="project-start" aria-labelledby="start-title">
        <h2 id="start-title">{t.projectStart}</h2>
        <p>{t.projectStartText}</p>
        <div class="project-start-links">
          <a class="button button-dark" href={project.documentation[lang]}>
            {t.projectDocs}
            <Icon name="external" size={18} />
          </a>
          <a class="text-link" href={repository}>
            {t.source}
            <Icon name="external" size={18} />
          </a>
        </div>
      </section>
    </article>
    <nav class="project-detail-section" aria-labelledby="related-title">
      <h2 id="related-title">{t.otherProjects}</h2>
      <div class="related-projects">
        {projects
          .filter((item) => item.name !== project.name)
          .map((item) => (
            <a href={item.documentation[lang]}>
              <span>{item.displayName}</span>
              <span aria-hidden="true">↗</span>
            </a>
          ))}
      </div>
    </nav>
  </main>
  <footer class="site-footer container">
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} Rambow Cloud</span>
      <a href={`${home}#projects`}>{t.nav[0]} ↑</a>
    </div>
  </footer>
</Layout>
